
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="001-create-kafka-clusters" author="justkafkait">

        <createTable tableName="kafka_clusters">

            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"
                             primaryKeyName="pk_kafka_clusters"
                             nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="bootstrap_servers" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>

            <column name="security_protocol" type="VARCHAR(30)" defaultValue="PLAINTEXT">
                <constraints nullable="false"/>
            </column>

            <column name="connection_timeout_ms" type="INTEGER" defaultValueNumeric="5000">
                <constraints nullable="false"/>
            </column>

            <column name="request_timeout_ms" type="INTEGER" defaultValueNumeric="10000">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="kafka_clusters"
                columnNames="name"
                constraintName="uk_kafka_clusters_name"/>

        <sql>
            ALTER TABLE kafka_clusters
            ADD CONSTRAINT chk_kafka_clusters_name
            CHECK (LENGTH(TRIM(name)) &gt; 0);
        </sql>

        <sql>
            ALTER TABLE kafka_clusters
            ADD CONSTRAINT chk_kafka_clusters_bootstrap_servers
            CHECK (LENGTH(TRIM(bootstrap_servers)) &gt; 0);
        </sql>

    </changeSet>

</databaseChangeLog>
